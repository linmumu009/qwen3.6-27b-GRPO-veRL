  "sources": [
    {
      "id": "paired_trajectory_analysis",
      "label": "同 prompt 轨迹配对分析",
      "path": "scripts/analyze_trajectory_comparison.py",
      "query": {
        "engine": "duckdb",
        "language": "sql",
        "sql": "SELECT * FROM (VALUES ('v24-166','v24',4519,80,1774.5,2980.3,4088,2.55,0.0954,7,11,6),('v24-191','v24',6484,80,1463.0,1906.7,2089,4.43,0.6778,7,6,4),('v24-260','v24',12798,80,1716.5,2413.8,2604,7.46,0.7965,17,16,4),('v26-286','v26',11932,80,1394.5,1997.55,2247,8.56,0.8117,8,11,3)) AS t(task,source_version,boss_original_tokens,our_samples,our_median_tokens,our_p95_tokens,our_max_tokens,boss_over_our_median,our_max_shorter_rate,boss_assistant_turns,boss_tool_calls,our_median_tool_call_tags)",
        "description": "扫描老板 v15 事件归档、训练元数据指向的 v24/v26 converted 轨迹、本次 320 条 rollout、verifier 清单与 Qwen3.6 tokenizer，按 source_file、task_id 和规范化 user text 做精确配对。",
        "executed_at": "2026-07-31T12:00:00+08:00",
        "filters": [
          "我们的正式 20-step 运行，共 320 条 rollout",
          "4 个唯一 verifier_id，均要求 prompt 文件与 verifier manifest 可连接",
          "exact-prompt 只使用训练元数据指向的 v24/v26 原始 converted 轨迹",
          "v15 仅用于总体背景，不用于同 prompt 比值"
        ],
        "metric_definitions": [
          "trajectory payload tokens = 对 assistant 内容、结构化 tool calls 与 tool outputs 按角色拼接后，用同一 Qwen3.6 tokenizer 编码的 token 数",
          "boss_over_our_median = 老板单条参考轨迹 payload tokens / 我们同 prompt 80 条 rollout 的 token 中位数",
          "our_max_shorter_rate = 1 - 我们同 prompt 最大 token 数 / 老板参考轨迹 payload tokens"
        ],
        "tables_used": [
          "trajectories_v15_27B_table.tar.gz",
          "qwen3.6-27B_20260628_v24_openai.jsonl",
          "qwen3.6-27B_20260628_v26_openai.jsonl",
          "train_20_unique_prompts.jsonl",
          "verifier_manifest.jsonl",
          "20-step rollout JSONL files"
        ]
      }
    },
    {
      "id": "driver_timing_analysis",
      "label": "20-step rollout 日志分析",
      "path": "runs/pi-grpo-megatron-tp4-pp2-cp2-tp8-dp2-20step-20260730-11/driver.log",
      "query": {
        "engine": "duckdb",
        "language": "sql",
        "sql": "SELECT * FROM (VALUES (1,107.65,247.91,3025),(2,102.39,217.16,2309),(3,107.59,202.66,2559),(4,120.04,198.25,2372),(5,117.90,231.85,2845),(6,130.45,234.48,3018),(7,126.29,302.19,3120),(8,134.45,269.61,2992),(9,106.67,202.24,2617),(10,111.86,196.61,2825),(11,110.82,160.88,2236),(12,132.14,440.23,4096),(13,107.08,183.93,1764),(14,107.95,196.86,2036),(15,122.92,213.47,2958),(16,122.92,288.50,2877),(17,108.24,199.43,2478),(18,110.58,161.73,2425),(19,118.78,255.36,2363),(20,97.78,178.85,2161)) AS t(step,mean_s,max_s,slowest_response_tokens)",
        "description": "从每个训练步的 driver 指标中提取每批 16 条轨迹的生成 min/mean/max、slowest response tokens、clip ratio 和 aborted ratio。",
        "executed_at": "2026-07-31T12:00:00+08:00",
        "filters": [
          "正式 20-step One-Step-Off-Policy 运行",
          "每步 batch 为 16 条轨迹",
          "超时命中只按每批 max 大于阈值计算保守下界"
        ],
        "metric_definitions": [
          "affected_batches = generate_sequences/max 严格大于 timeout_s 的训练步数量",
          "minimum_trajectories = 每个受影响 batch 至少有一条超时，因此等于 affected_batches",
          "Pearson 相关系数使用 20 个 batch 的最慢耗时与对应 slowest response tokens"
        ],
        "tables_used": [
          "driver step metrics"
        ]
      }
    },
    {
      "id": "fully_async_evidence",
      "label": "bounded fully-async 三步实测",
      "path": "runs/pi-grpo-fully-async-bounded-3step-20260730-02/driver.log",
      "query": {
        "engine": "log-audit",
        "language": "text",
        "query": "Read queue wait, actor update, queued group and queued-token metrics from the validated three-step run.",
        "description": "审计三步 bounded fully-async 运行中的完整 GRPO group 队列、等待时间、背压和 trainer 利用率。",
        "executed_at": "2026-07-31T12:00:00+08:00",
        "filters": [
          "每步消费 4 个完整 group",
          "最大 6 groups / 40k queued tokens",
          "仅使用已有三步验证运行"
        ],
        "metric_definitions": [
          "等待降低率 = 1 - 第二批 queue wait / 第一批 queue wait",
          "有效 group 容量估算 = queued-token 上限 / 本次平均每 group tokens"
        ],
        "tables_used": [
          "fully-async driver metrics",
          "validation_summary.json"
        ]
      }
    },
    {
      "id": "verl_source_audit",
      "label": "veRL rollout、消息队列和 vLLM 取消路径审计",
      "path": "reference/verl",
      "query": {
        "engine": "source-audit",
        "language": "python",
        "query": "Trace AgentLoopWorker task gathering, FullyAsyncRollouter group enqueue, MessageQueue storage, LLMServerClient request IDs, and vLLM abort_request handling.",
        "description": "只读审计本地 veRL 参考源码与当前补丁，定位 batch 等待、完整 group 入队、物理请求 ID 和 per-request abort 的实现边界。",
        "executed_at": "2026-07-31T12:00:00+08:00",
        "filters": [
          "不修改远端训练环境",
          "以本次使用的 fully-async、agent loop 和 vLLM 路径为范围"
        ],
        "metric_definitions": [
          "完整 GRPO group = 同一 prompt 的 n=4 responses，作为不可拆分训练单元",
          "真取消 = server 确认 abort 物理 vLLM request 后才释放并发槽",
          "zombie request = 上层已放弃但底层仍继续生成的请求"
        ],
        "tables_used": [
          "AgentLoopWorker",
          "ToolAgentLoop",
          "FullyAsyncRollouter",
          "MessageQueue",
          "LLMServerClient",
          "vLLM abort_request"
        ]
      }
    }
  ]
}
